# Optional. Defaults to ./config/policy.yaml
RWMCP_POLICY=./config/policy.yaml

# HTTP transport is loopback-only.
RWMCP_PORT=8765

# Optional audit path. Defaults to ./runtime/audit.jsonl
RWMCP_AUDIT=./runtime/audit.jsonl

# Optional observability tags for a dedicated client instance/profile.
# These are NOT authentication identities in v0.2.
RWMCP_CLIENT_ID=local-client
RWMCP_CLIENT_TYPE=mcp-client
