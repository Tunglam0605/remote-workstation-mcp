# Optional. Defaults to ./config/policy.yaml
RWMCP_POLICY=./config/policy.yaml

# HTTP transport is loopback-only by default.
RWMCP_PORT=8765

# Local-only Setup Console preferred port. If occupied, the console searches
# higher loopback ports automatically.
# RWMCP_SETUP_PORT=8684

# HTTP authentication. "none" preserves local loopback compatibility.
# Use bearer mode when a trusted gateway/tunnel should authenticate one principal
# before requests enter the workstation policy boundary.
RWMCP_HTTP_AUTH_MODE=none
# RWMCP_HTTP_BEARER_TOKEN=<at-least-32-random-characters>
# RWMCP_HTTP_PRINCIPAL_ID=chatgpt-web
# RWMCP_HTTP_PRINCIPAL_TYPE=mcp-http
# RWMCP_HTTP_SCOPES=workstation.read,workstation.write,workstation.execute

# Optional OpenAI Secure MCP Tunnel connection provider.
# Keep CONTROL_PLANE_API_KEY only in the process environment or save it through
# the Windows Setup Console, which protects it with the current user's DPAPI.
# CONTROL_PLANE_TUNNEL_ID=tunnel_0123456789abcdef0123456789abcdef
# CONTROL_PLANE_API_KEY=<runtime-api-key-with-tunnels-read-use>
# CONTROL_PLANE_ORGANIZATION_ID=org_example
# RWMCP_OPENAI_TUNNEL_CLIENT=./runtime/openai-tunnel/tunnel-client
# RWMCP_OPENAI_TUNNEL_READY_TIMEOUT_MS=60000
# RWMCP_OPENAI_TUNNEL_DIR=./runtime/openai-tunnel
# Managed Cloudflare runtime material is optional and disabled by default.
# Set true only for a tunnel that has managed Cloudflare runtime material.
# CLOUDFLARED_MANAGED=false

# Optional audit path. Defaults to ./runtime/audit.jsonl
RWMCP_AUDIT=./runtime/audit.jsonl

# Fallback observability/client profile tags for local transports that do not
# establish an authenticated request principal. Authenticated HTTP principals
# override these tags for audit and client-bound lease evaluation.
RWMCP_CLIENT_ID=local-client
RWMCP_CLIENT_TYPE=mcp-client
