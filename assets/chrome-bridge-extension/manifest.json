{
  "manifest_version": 3,
  "name": "RWMCP Existing Chrome Bridge",
  "version": "0.2.0",
  "description": "Owner-visible bridge between an authenticated Chrome tab and Remote Workstation MCP.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "tabs"
  ],
  "host_permissions": [
    "https://notebooklm.google.com/*",
    "https://notebook.google.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://notebooklm.google.com/*",
        "https://notebook.google.com/*"
      ],
      "js": [
        "content-script.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "RWMCP Existing Chrome Bridge"
  }
}
